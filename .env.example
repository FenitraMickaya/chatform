# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/formpulse
# Supabase: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/formpulse"

# Set to "true" when the provider requires TLS (Supabase, Neon, Vercel Postgres…).
DATABASE_SSL="false"

# Maximum number of pooled connections.
DATABASE_POOL_MAX="10"
